# Configuración de Hadoop para la imagen oficial apache/hadoop.
# Cada línea FICHERO.XML_propiedad=valor se convierte en una propiedad del XML correspondiente.
# Tras cambiar algo:  docker compose up -d --force-recreate namenode datanode

# ---- core-site.xml
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
CORE-SITE.XML_hadoop.http.staticuser.user=hadoop

# ---- hdfs-site.xml
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.name.dir=/tmp/hdfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=/tmp/hdfs/data
# 3 réplicas por bloque (hay 3 DataNodes)
HDFS-SITE.XML_dfs.replication=3
# Bloque de 32 MB (en producción suele ser 128 MB). Así los ficheros del proyecto ocupan varios bloques.
HDFS-SITE.XML_dfs.blocksize=33554432
# Permisos desactivados para simplificar el laboratorio (en producción: activados + Kerberos)
HDFS-SITE.XML_dfs.permissions.enabled=false
HDFS-SITE.XML_dfs.webhdfs.enabled=true
# Un DataNode se declara MUERTO a los ~90 s en vez de ~10,5 min (para poder verlo en clase)
HDFS-SITE.XML_dfs.namenode.heartbeat.recheck-interval=30000
HDFS-SITE.XML_dfs.heartbeat.interval=3
# Verificación periódica de bloques (block scanner) cada hora en lugar de cada 3 semanas
HDFS-SITE.XML_dfs.datanode.scan.period.hours=1
# Informe de bloques cada 5 minutos (por defecto 6 h)
HDFS-SITE.XML_dfs.blockreport.intervalMsec=300000
HDFS-SITE.XML_dfs.namenode.safemode.extension=5000
# Las IP de los contenedores cambian: no verificar nombres DNS inversos
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false

# ---- MapReduce en modo local (para los ejemplos con «hadoop jar»; no hay YARN)
MAPRED-SITE.XML_mapreduce.framework.name=local
